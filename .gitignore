# Dependencies
node_modules/

# npm pack output
*.tgz

# Python bytecode
__pycache__/
*.pyc

# OS files
.DS_Store

# Installer state and local skill links. These appear in skills/ when the
# global OpenCode skills directory is symlinked to this checkout.
skills/.opencode-codeops.json
skills/blendsdk

# Project-scope CodeOps install (regenerated by `npx opencode-codeops update`);
# keep it out of git so it never blocks the release clean-tree check.
.opencode/
